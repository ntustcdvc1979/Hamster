{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": true,
        ".write": true,
        "meta": {
          "radius": { ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 200" }
        },
        "spots": {
          "$spot": {
            ".validate": "newData.hasChildren(['lat', 'lng', 'item'])"
          }
        }
      }
    }
  }
}
