{
  "rules": {
    ".read": false,
    ".write": false,
    "hamster": {
      ".read": true,
      "meta": {
        ".write": true,
        "radius": {
          ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 200"
        }
      },
      "spots": {
        ".write": true,
        "$item": {
          ".validate": "$item.matches(/^(wheel|nest|seed|chew)$/) && newData.hasChildren(['lat', 'lng'])",
          "lat": {
            ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
          },
          "lng": {
            ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
          }
        }
      },
      "items": {
        ".write": true,
        "$item": {
          ".validate": "$item.matches(/^(wheel|nest|seed|chew)$/)",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "mission": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "meaning": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "question": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "players": {
        ".write": true,
        "$pid": {
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "found": {
            "$item": {
              ".validate": "$item.matches(/^(wheel|nest|seed|chew)$/) && newData.isNumber()"
            }
          },
          "done": {
            "$item": {
              ".validate": "$item.matches(/^(wheel|nest|seed|chew)$/) && newData.isNumber()"
            }
          }
        }
      },
      "round": {
        ".write": true,
        ".validate": "newData.hasChildren([\"id\",\"cell\"])",
        "id": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "cell": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 12"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        },
        "revealed": {
          ".validate": "newData.isBoolean()"
        }
      },
      "prompts": {
        ".write": true,
        "$i": {
          ".validate": "$i.matches(/^([0-9]|1[01])$/) && newData.isString() && newData.val().length <= 40"
        }
      }
    }
  }
}
